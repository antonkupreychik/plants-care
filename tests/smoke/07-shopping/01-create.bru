meta {
  name: Shopping – create item
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/shopping
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Smoke Test Fertilizer"
  }
}

assert {
  res.status: eq 201
  res.body.id: isNumber
  res.body.title: eq Smoke Test Fertilizer
  res.body.checked: eq false
}

script:post-response {
  bru.setVar("shoppingItemId", res.body.id);
}
