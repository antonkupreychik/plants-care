meta {
  name: Edge – 400 monthly report bad month format
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/reports/monthly
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  month: 2025-13
}

assert {
  res.status: eq 400
  res.body.error: isDefined
}
