meta {
  name: Me – patch settings (timezone + quiet hours)
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "timezone": "Europe/Moscow",
    "quietHoursStart": "23:00",
    "quietHoursEnd": "08:00"
  }
}

assert {
  res.status: eq 200
  res.body.timezone: eq Europe/Moscow
  res.body.quietHoursStart: eq 23:00
  res.body.quietHoursEnd: eq 08:00
}
