meta {
  name: Care Events – log watering
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/care-events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  bru.setVar("clientId", "smoke-test-idem-001");
  bru.setVar("performedAt", new Date().toISOString());
}

body:json {
  {
    "plantId": {{plantId}},
    "type": "WATER",
    "performedAt": "{{performedAt}}",
    "note": "Smoke test watering",
    "clientId": "{{clientId}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: isNumber
  res.body.plantId: eq {{plantId}}
  res.body.type: eq WATER
  res.body.clientId: eq smoke-test-idem-001
}

script:post-response {
  bru.setVar("careEventId", res.body.id);
}
