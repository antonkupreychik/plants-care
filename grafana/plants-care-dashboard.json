          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "100 * sum(rate(notifications_failed_total[5m])) / (sum(rate(notifications_sent_total[5m])) + sum(rate(notifications_failed_total[5m])))",
