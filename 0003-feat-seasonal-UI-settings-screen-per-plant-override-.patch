+    private void handleSeasonalCallback(
+            String data, String callbackId, Integer messageId,
+            TelegramClient client, User user
+    ) {
+        log.info("Seasonal callback received: data={}, user={}, messageId={}",
+                data, user.getTelegramChatId(), messageId);
+
+        if (seasonalMenuService == null) {
+            log.error("SeasonalMenuService bean is NULL — DI broken");
+            answerCallback(client, callbackId, "Внутренняя ошибка (см. логи)");
+            return;
+        }
+
+        try {
+            String[] parts = data.split(":");
+            // parts[0] всегда «SEASON». parts[1] — action.
+            switch (parts.length > 1 ? parts[1] : "") {
+                case "TOGGLE" -> {
+                    seasonalMenuService.toggleEnabled(user, messageId, client);
+                    answerCallback(client, callbackId, "");
+                }
+                case "MODE" -> {
+                    if (parts.length != 3) {
+                        answerCallback(client, callbackId, "❌ Неверный формат");
+                        return;
+                    }
+                    com.plantcare.bot.domain.enums.SeasonalMode mode;
+                    try {
+                        mode = com.plantcare.bot.domain.enums.SeasonalMode.valueOf(parts[2]);
+                    } catch (IllegalArgumentException ex) {
+                        answerCallback(client, callbackId, "❌ Неизвестный режим");
+                        return;
+                    }
+                    seasonalMenuService.setMode(user, mode, messageId, client);
+                    answerCallback(client, callbackId, "");
+                }
+                case "MUL" -> {
+                    if (parts.length != 3) {
+                        answerCallback(client, callbackId, "❌ Неверный формат");
+                        return;
+                    }
+                    com.plantcare.bot.domain.enums.Season s = parseSeason(parts[2]);
+                    if (s == null) {
+                        answerCallback(client, callbackId, "❌ Неверный сезон");
+                        return;
+                    }
+                    seasonalMenuService.cycleMultiplier(user, s, messageId, client);
+                    answerCallback(client, callbackId, "");
+                }
+                case "INT" -> {
+                    if (parts.length < 3 || parts.length > 4) {
+                        answerCallback(client, callbackId, "❌ Неверный формат");
+                        return;
+                    }
+                    com.plantcare.bot.domain.enums.Season s = parseSeason(parts[2]);
+                    if (s == null) {
+                        answerCallback(client, callbackId, "❌ Неверный сезон");
+                        return;
+                    }
+                    if (parts.length == 4 && "CLEAR".equals(parts[3])) {
+                        seasonalMenuService.clearInterval(user, s, messageId, client);
+                    } else {
+                        seasonalMenuService.cycleInterval(user, s, messageId, client);
+                    }
+                    answerCallback(client, callbackId, "");
+                }
+                default -> answerCallback(client, callbackId, "❌ Неизвестное действие");
+            }
+        } catch (Exception e) {
+            log.error("Seasonal callback {} failed for user {}: {}",
+                    data, user.getTelegramChatId(), e.getMessage(), e);
+            answerCallback(client, callbackId, "Ошибка: " + e.getMessage());
+        }
+    }
+
+    private static com.plantcare.bot.domain.enums.Season parseSeason(String s) {
+        return switch (s) {
+            case "SUMMER" -> com.plantcare.bot.domain.enums.Season.SUMMER;
+            case "WINTER" -> com.plantcare.bot.domain.enums.Season.WINTER;
+            default -> null;
+        };
+    }
